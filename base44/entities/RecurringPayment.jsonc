{
  "name": "RecurringPayment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Obligation name, e.g. 'Hall Rent', 'Insurance'"
    },
    "amount": {
      "type": "number",
      "description": "Amount in GBP"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "quarterly",
        "6_months",
        "yearly"
      ],
      "description": "Payment frequency"
    },
    "category": {
      "type": "string",
      "enum": [
        "hall_hire",
        "equipment",
        "food",
        "transport",
        "badges",
        "insurance",
        "subscriptions",
        "other"
      ],
      "description": "Expense category (mapped to a ledger category when confirmed paid)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "standing_order",
        "manual_payment"
      ],
      "description": "standing_order = paid automatically from the bank (treasurer verifies); manual_payment = treasurer pays it via the bank app"
    },
    "next_due_date": {
      "type": "string",
      "format": "date",
      "description": "Next payment due date"
    },
    "last_paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date the last payment was confirmed"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Is this recurring obligation active"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "name",
    "amount",
    "frequency"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    }
  }
}