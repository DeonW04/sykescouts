{
  "name": "ConsentFormSubmission",
  "type": "object",
  "properties": {
    "form_id": {
      "type": "string",
      "description": "ConsentForm ID"
    },
    "member_id": {
      "type": "string",
      "description": "Member ID"
    },
    "event_id": {
      "type": "string",
      "description": "Event ID (if event-linked)"
    },
    "programme_id": {
      "type": "string",
      "description": "Programme ID (if meeting-linked)"
    },
    "responses": {
      "type": "object",
      "description": "Map of block_id to response value"
    },
    "tc_accepted": {
      "type": "boolean",
      "default": false
    },
    "sign_token": {
      "type": "string",
      "description": "Unique token for QR signature link"
    },
    "signature_data_url": {
      "type": "string",
      "description": "Legacy signature PNG data URL"
    },
    "signature_file_uri": {
      "type": "string",
      "description": "Privately stored signature file"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "awaiting_signature",
        "signed",
        "complete"
      ],
      "default": "pending"
    },
    "parent_name": {
      "type": "string"
    },
    "signed_via_app": {
      "type": "boolean",
      "default": false,
      "description": "True if signed through the SykeScouts app"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "form_id",
    "member_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "leader"
          }
        },
        {
          "user_condition": {
            "role": "team_leader"
          }
        },
        {
          "user_condition": {
            "role": "glv"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "leader"
          }
        },
        {
          "user_condition": {
            "role": "team_leader"
          }
        },
        {
          "user_condition": {
            "role": "glv"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "leader"
          }
        },
        {
          "user_condition": {
            "role": "team_leader"
          }
        },
        {
          "user_condition": {
            "role": "glv"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "leader"
          }
        },
        {
          "user_condition": {
            "role": "team_leader"
          }
        },
        {
          "user_condition": {
            "role": "glv"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    }
  }
}