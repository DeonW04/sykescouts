{
  "name": "ReceiptAllocation",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "Linked receipt/upload ID or URL"
    },
    "receipt_url": {
      "type": "string",
      "description": "Receipt image URL"
    },
    "amount": {
      "type": "number",
      "description": "Amount on receipt in GBP"
    },
    "category": {
      "type": "string",
      "enum": [
        "equipment",
        "food",
        "transport",
        "hall_hire",
        "badges",
        "other"
      ],
      "description": "Expense category"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "scout_bank_card",
        "leader_paid_personally"
      ],
      "description": "How it was paid"
    },
    "expense_scope": {
      "type": "string",
      "enum": [
        "single",
        "group",
        "split"
      ],
      "default": "single",
      "description": "single = one section/meeting/event or general; group = whole group expense; split = shared between two sections"
    },
    "linked_event_id": {
      "type": "string",
      "description": "Linked event ID"
    },
    "linked_meeting_id": {
      "type": "string",
      "description": "Linked meeting/programme ID"
    },
    "section_id": {
      "type": "string",
      "description": "Primary section this expense is allocated to"
    },
    "split_section_id": {
      "type": "string",
      "description": "Second section ID when splitting between two sections"
    },
    "split_amount": {
      "type": "number",
      "description": "Amount allocated to the second section when splitting (remainder goes to the primary section)"
    },
    "split_meeting_id": {
      "type": "string",
      "description": "Optional second meeting ID when splitting between two sections for a meeting"
    },
    "linked_term_id": {
      "type": "string",
      "description": "Optional linked term ID for budget allocation"
    },
    "budget_allocated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this expense is allocated to a section budget"
    },
    "leader_id": {
      "type": "string",
      "description": "Leader ID if paid personally"
    },
    "leader_name": {
      "type": "string",
      "description": "Display name of the leader who submitted the receipt"
    },
    "submitted_by": {
      "type": "string",
      "description": "Email of the user who submitted the receipt"
    },
    "allocated_by": {
      "type": "string",
      "description": "Treasurer email who allocated this"
    },
    "allocation_date": {
      "type": "string",
      "format": "date",
      "description": "Date allocated"
    },
    "ledger_entry_id": {
      "type": "string",
      "description": "Linked ledger entry"
    },
    "reimbursement_id": {
      "type": "string",
      "description": "Linked reimbursement if created"
    },
    "status": {
      "type": "string",
      "enum": [
        "unallocated",
        "allocated"
      ],
      "default": "unallocated",
      "description": "Allocation status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "amount",
    "category",
    "payment_method"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        },
        {
          "user_condition": {
            "role": "glv"
          }
        },
        {
          "user_condition": {
            "role": "team_leader"
          }
        },
        {
          "data.submitted_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "treasurer"
          }
        }
      ]
    }
  }
}